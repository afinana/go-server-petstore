# ==============================================================================
# Go Petstore Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server address and port
SERVER_ADDR=localhost:8080

# MongoDB database connection
DATABASE_URI=mongodb://localhost:27017
DATABASE_NAME=petstore
ENABLE_CREDENTIALS=false
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Gateway Security & Authentication
# Shared secret required in X-Gateway-Secret header (optional defense-in-depth)
GATEWAY_SECRET=

# Enable/disable gateway header validation and ABAC (default: true)
# Set to false to bypass authentication in local development
ENABLE_AUTH_VALIDATION=true
